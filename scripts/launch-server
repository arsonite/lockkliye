# Third-party imports
from teatype.cli import BaseStartCLI
from teatype.io import path

class LaunchServer(BaseStartCLI):
    def pre_execute(self):
        self.process_name = 'lockkliye_server'
        # The HSDB unit needs fastapi and uvicorn, which the teatype venv provides
        venv_python = path.join(self.parent_path, '..', '..', 'teatype', 'teatype-venv', 'bin', 'python')
        self.start_command = f'{venv_python} {self.process_name}.py'

if __name__ == '__main__':
    LaunchServer()
