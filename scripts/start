# System imports
import os
import shlex
import shutil
import sys

# Third-party imports
from teatype.cli import BaseStartCLI
from teatype.io import shell, softkill
from teatype.logging import *

class Start(BaseStartCLI):
    """
    Starts the HSDB server, the vite client or both: "start all|client|server [--detached]".
    "start build" makes the production build instead, which nginx then serves in place of the vite dev server; starting
    the client (or all) removes that build again.
    What of lockkliye still runs from an earlier start is stopped first, so a restart never ends up with a stale process.
    """
    def modified_meta(self):
        return {
            'commands': [
                {
                    'name': 'all',
                    'shorthand': 'a',
                    'help': 'Server in the background, client in the foreground (both in the background with --detached)'
                },
                {
                    'name': 'build',
                    'shorthand': 'b',
                    'help': 'Production build into dist/ (served by nginx), stops the vite dev server'
                },
                {
                    'name': 'client',
                    'shorthand': 'c',
                    'help': 'The vite dev server'
                },
                {
                    'name': 'server',
                    'shorthand': 's',
                    'help': 'The HSDB server'
                }
            ]
        }

    ###########
    # Helpers #
    ###########

    def _stop_running(self, *targets:str):
        """
        Stops the processes of this checkout, matched by the paths in their command line, so other projects
        (e.g. tickfit) that run their own vite or HSDB server are left alone.
        """
        names = {
            'client': [os.path.join(self._root, 'node_modules', '.bin', '..', 'vite', 'bin', 'vite.js'),
                       os.path.join(self._root, 'node_modules', '.pnpm', 'vite@')],
            'server': [os.path.join(self._root, 'lockkliye_server.py')]
        }
        for target in targets:
            stopped = softkill(names[target], silent=True)
            if stopped:
                log(f'Stopped the running {target} ({stopped} process{"es" if stopped > 1 else ""})')

    def _build(self):
        """
        The production build: dist/ is what nginx serves instead of the dev server (homepie nginx/snippets/homepie-app.conf).
        Built next to it and swapped in at the end, so a failed build changes nothing and the gap is a rename.
        """
        out, old = os.path.join(self._root, 'dist.new'), os.path.join(self._root, 'dist.old')
        dist = os.path.join(self._root, 'dist')
        shutil.rmtree(out, ignore_errors=True)
        log('Building ...')
        # Not "pnpm build": its tsc -b step type checks teatype/ts as well
        if shell(f'cd {shlex.quote(self._root)} && pnpm exec vite build --outDir dist.new --emptyOutDir') not in (0, None) \
           or not os.path.isfile(os.path.join(out, 'index.html')):
            shutil.rmtree(out, ignore_errors=True)
            err('The build failed, nothing was changed', exit=True)
        shutil.rmtree(old, ignore_errors=True)
        if os.path.isdir(dist):
            os.rename(dist, old)
        os.rename(out, dist)
        shutil.rmtree(old, ignore_errors=True)
        self._stop_running('client')
        # The build talks to the HSDB server directly, so that has to be there
        if shell(f'pgrep -f {shlex.quote(os.path.join(self._root, "[l]ockkliye_server.py"))} > /dev/null') != 0:
            log('Starting the server in the background')
            command = f'{shlex.quote(sys.executable)} {shlex.quote(os.path.realpath(__file__))} server --detached --silent'
            if shell(command) not in (0, None):
                err('The server could not be started', exit=True)
        success('Production build is live: dist/ is served, the dev server is stopped. "start client" brings dev mode back.')
        sys.exit(0)

    def _remove_build(self):
        # Without dist/ nginx goes back to the dev server
        dist = os.path.join(self._root, 'dist')
        if os.path.isdir(dist):
            shutil.rmtree(dist)
            log('Removed dist/, nginx serves the dev server again')

    #########
    # Hooks #
    #########

    def implemented_trap(self):
        # Only what this script started in the foreground session, detached runs are stopped by the next start
        if self.get_flag('detached'):
            return
        self._stop_running(*getattr(self, '_foreground', []))

    def pre_execute(self):
        self._root = os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), '..'))
        # The processes run from the repository root, where their .env is
        self.parent_path = self._root
        # The base class would only look for a "stop" script, the stopping is done here
        self.set_flag('ignore-running', True)

        target = self.get_command()
        if target == 'build':
            self._build()
        if target in ('all', 'client'):
            self._remove_build()
        if target == 'all':
            self._stop_running('server', 'client')
            log('Starting the server in the background')
            command = f'{shlex.quote(sys.executable)} {shlex.quote(os.path.realpath(__file__))} server --detached --silent'
            if shell(command) not in (0, None):
                err('The server could not be started', exit=True)
            self._foreground = ['server', 'client']
            target = 'client'
        else:
            self._stop_running(target)
            self._foreground = [target]

        self.process_name = f'lockkliye_{target}'
        if target == 'client':
            self.start_command = 'pnpm start'
        else:
            # The HSDB unit needs fastapi and uvicorn, which the teatype venv provides, the one this script runs in
            self.start_command = f'{shlex.quote(sys.executable)} {shlex.quote(os.path.join(self._root, "lockkliye_server.py"))}'

if __name__ == '__main__':
    Start()
