set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEATYPE_ROOT="$(cd "$SCRIPT_DIR/../../teatype" && pwd)"
# The pnpm workspace root lives in teatype/ts, installing from here would not resolve workspace:* deps
WORKSPACE_ROOT="$TEATYPE_ROOT/ts"
# The backend (lockkliye_server.py, scripts/launch-server) runs in the teatype venv
VENV="$TEATYPE_ROOT/teatype-venv"
PYTHON="${PYTHON:-python3.13}"
ENV_FILE="$SCRIPT_DIR/../.env"

if ! command -v pnpm &> /dev/null; then
    echo "Error: pnpm not found. Install it first (e.g. 'corepack enable')"
    exit 1
fi

if [ ! -x "$VENV/bin/python" ]; then
    if ! command -v "$PYTHON" &> /dev/null; then
        echo "Error: $PYTHON not found. Install it or run with PYTHON=<interpreter>"
        exit 1
    fi
    "$PYTHON" -m venv "$VENV"
fi

if [ ! -f "$ENV_FILE" ]; then
    echo "Creating .env from .env.template ..."
    cp "$SCRIPT_DIR/../.env.template" "$ENV_FILE"
fi

# A variable that is already set wins over .env, like in the server
DATA_PATH="${LOCKKLIYE_DATA_PATH:-$(grep -E '^LOCKKLIYE_DATA_PATH=' "$ENV_FILE" | tail -1 | cut -d= -f2- | tr -d "\"'\r")}"
DATA_PATH="${DATA_PATH:-/var/lib/lockkliye}"
OWNER="${SUDO_USER:-$(id -un)}"

# Only asks for sudo when the user cannot create it himself, e.g. directly below /var/lib. 750, the notes are private.
echo "Creating the data directory $DATA_PATH ..."
if ! { mkdir -p "$DATA_PATH" 2>/dev/null && [ "$(stat -c %U "$DATA_PATH")" = "$OWNER" ]; }; then
    sudo install -d -o "$OWNER" -g "$(id -gn "$OWNER")" -m 750 "$DATA_PATH"
fi
chmod 750 "$DATA_PATH"

HSDB_PATH="/var/lib/hsdb"
echo "Creating the HSDB directory $HSDB_PATH ..."
if ! { mkdir -p "$HSDB_PATH" 2>/dev/null && [ "$(stat -c %U "$HSDB_PATH")" = "$OWNER" ]; }; then
    sudo install -d -o "$OWNER" -g "$(id -gn "$OWNER")" -m 750 "$HSDB_PATH"
fi
chmod 750 "$HSDB_PATH"

echo "Installing frontend dependencies ..."
(cd "$WORKSPACE_ROOT" && pnpm install)

echo "Installing backend dependencies ..."
# Editable teatype brings its own requirements, FastAPI and uvicorn serve the HSDB unit and are pinned in the fastapi extras
"$VENV/bin/pip" install -e "$TEATYPE_ROOT/py"
grep -E '^(fastapi|uvicorn)==' "$TEATYPE_ROOT/py/requirements/fastapi-support.txt" | xargs "$VENV/bin/pip" install

