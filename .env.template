# Copy to .env (git-ignored) to change a value, the defaults below are used otherwise.
# Port of the vite dev server, homepie's nginx forwards https://lockkliye.homepie.net to it
# (homepie/src/nginx/conf.d/00-homepie-apps.conf)
LOCKKLIYE_CLIENT_PORT=8101
# Port of the HSDB server (lockkliye_server.py), only on 127.0.0.1. vite proxies /hsdb to it.
# lockkliye_server.py reads it from the process environment, not from .env
LOCKKLIYE_PORT=8765
