# Copy to .env (git-ignored) to change a value, the defaults below are used otherwise.
# Port of the vite dev server, homepie's nginx forwards https://homepie.net/lockkliye/ to it
# (homepie/src/nginx/conf.d/00-homepie-apps.conf)
LOCKKLIYE_CLIENT_PORT=8101
# Path the app is served under. Standalone it is /, homepie publishes it at https://homepie.net/lockkliye/
# (homepie/src/nginx/conf.d/00-homepie-apps.conf), so set /lockkliye/ on that server
LOCKKLIYE_BASE_PATH=/
# Port of the HSDB server (lockkliye_server.py), only on 127.0.0.1. vite proxies /hsdb to it.
# lockkliye_server.py reads .env itself, a variable that is already set in the process environment wins
LOCKKLIYE_PORT=8765

# Where the HSDB server keeps its data (<path>/hsdb/lockkliye/), scripts/install creates it owned by the user
LOCKKLIYE_DATA_PATH=/var/lib/lockkliye